{
  "name": "chess-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Personal chess game review and coaching app: local Stockfish analysis, verified explanations, training from your own mistakes.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "proxy:deploy": "cd proxy && npx wrangler deploy",
    "openings": "node scripts/build-openings.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "chessops": "^0.15.1",
    "dexie": "^4.4.7",
    "maia3-js": "^0.2.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
